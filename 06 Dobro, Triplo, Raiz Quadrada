#Crie um algoritmo que leia um número e mostre seu dobro, triplo e raiz quadrada.

n = int(input(print('Digite um Número: ')))

print('O Dobro* de {} é {}\nO Triplo* é {}\nA Raiz Quadrada** é {:.3f}'.format(n, n*2, n*3, n**(1/2)))

